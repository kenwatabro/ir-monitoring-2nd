# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.

# EDINET API
EDINET_API_KEY=your_edinet_api_key

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ir_monitoring
POSTGRES_USER=ir_user
POSTGRES_PASSWORD=your_password
# Optional: set PGURL to override individual POSTGRES_* vars
# PGURL=postgresql://ir_user:your_password@localhost:5432/ir_monitoring

# Logging
LOG_LEVEL=INFO

# Optional API keys (only needed for specific features)
# FRED_API_KEY=
# JQUANTS_REFRESH_TOKEN=
# JQUANTS_MAIL=
# JQUANTS_PASSWORD=
# ESTAT_APP_ID=
